<?xml version="1.0" encoding="utf-8"?>
<network-security-config>
    <!-- 需要支持 NAS 的局域网 http 地址以及 ug.link 的 http->https 跳转 -->
    <base-config cleartextTrafficPermitted="true">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
</network-security-config>
